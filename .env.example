# 云宿 SaaS 环境变量示例
# 复制为 .env 后按实际环境修改；生产环境请务必更换数据库密码、Redis 密码与 JWT_SECRET。

# ---------- 服务端口 ----------
SERVER_PORT=8080
ADMIN_PORT=5173
PORTAL_PORT=5174
# 端口被占用时是否自动顺延（true/false）
PORT_FALLBACK=true

# ---------- MySQL 8 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_saas
DB_USERNAME=hotel
DB_PASSWORD=Hotel@2026
# 首次自动建库时可选；已有库可留空
# DB_ROOT_PASSWORD=
# 启动时执行 sql/init.sql（幂等）
DB_AUTO_INIT=true

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 不可用时是否允许降级启动（生产建议 false）
ALLOW_DEGRADED=false

# ---------- 构建与依赖 ----------
# auto：源码比 jar 新时构建；true：每次构建；false：不构建
BUILD_BACKEND=auto
# 缺少 node_modules 时自动 npm install
INSTALL_DEPS=true

# ---------- 端启动开关 ----------
START_ADMIN=true
START_PORTAL=true

# ---------- 安全 ----------
JWT_SECRET=hotel-saas-2026-please-change-this-secret-key-0123456789abcdef
JWT_EXPIRE_HOURS=12
# 上传目录与对外基础地址（生产改为 https://your-domain）
UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080
