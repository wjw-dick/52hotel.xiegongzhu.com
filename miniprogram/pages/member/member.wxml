<view class="container">
  <block wx:if="{{!member}}">
    <view class="card" style="margin-top:20rpx">
      <view class="section-title">微信登录（演示）</view>
      <view class="muted" style="line-height:1.8;margin-bottom:20rpx">
        演示环境使用固定 OpenId 模拟微信授权；正式环境由小程序登录换取 openid/unionid。
      </view>
      <view class="field">
        <view class="label">昵称</view>
        <input class="input full" value="{{nickname}}" bindinput="onNickname" placeholder="微信昵称" />
      </view>
      <view class="field">
        <view class="label">手机号（选填）</view>
        <input class="input full" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="用于订单匹配" />
      </view>
      <button class="btn" loading="{{logging}}" bindtap="login">微信一键登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="row" style="gap:24rpx">
        <view class="avatar">{{ avatarText }}</view>
        <view style="flex:1">
          <view style="font-size:34rpx;font-weight:600">{{ member.name || '微信用户' }}</view>
          <view class="muted" style="margin-top:6rpx">{{ member.phone || '未绑定手机号' }}</view>
          <view class="tag" style="margin-top:10rpx">{{ level.name || '普通会员' }}</view>
        </view>
        <view class="tag muted" bindtap="logout">退出</view>
      </view>
      <view class="grid-2" style="margin-top:28rpx;text-align:center">
        <view style="border:1rpx solid #e7e4da;padding:20rpx;border-radius:4rpx">
          <view class="price">{{ member.points || 0 }}</view>
          <view class="muted">可用积分</view>
        </view>
        <view style="border:1rpx solid #e7e4da;padding:20rpx;border-radius:4rpx">
          <view class="price">{{ couponCount }}</view>
          <view class="muted">可用优惠券</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title" style="font-size:30rpx">我的订单</view>
      <view wx:if="{{!orders.length}}" class="empty">暂无订单</view>
      <view wx:for="{{orders}}" wx:key="id" style="border-bottom:1rpx solid #f0eee7;padding:16rpx 0">
        <view class="row between">
          <view style="font-weight:600">{{ item.orderNo }}</view>
          <view class="tag {{item.statusClass}}">{{ item.statusText }}</view>
        </view>
        <view class="muted" style="margin:8rpx 0">{{ item.checkIn }} → {{ item.checkOut }} · {{ item.nights }} 晚</view>
        <view class="row between">
          <view class="price" style="font-size:28rpx">¥{{ item.amountText }}</view>
          <view wx:if="{{item.status === 'PENDING' || item.status === 'CONFIRMED'}}" class="tag" data-id="{{item.id}}" bindtap="cancelOrder">取消订单</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title" style="font-size:30rpx">积分明细</view>
      <view wx:if="{{!points.length}}" class="empty">暂无积分记录</view>
      <view wx:for="{{points}}" wx:key="id" class="summary-line">
        <text>{{ item.reason }} · {{ item.timeText }}</text>
        <text style="color:{{item.changeValue > 0 ? '#24483c' : '#c0392b'}}">{{ item.changeText }}</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title" style="font-size:30rpx">我的优惠券</view>
      <view wx:if="{{!coupons.length}}" class="empty">暂无优惠券</view>
      <view wx:for="{{coupons}}" wx:key="id" class="row between" style="border-bottom:1rpx solid #f0eee7;padding:16rpx 0">
        <view>
          <view style="font-weight:600">{{ item.name }}</view>
          <view class="muted">有效期至 {{ item.expireDate || '长期' }}</view>
        </view>
        <view class="price" style="font-size:34rpx">¥{{ item.amountText }}</view>
      </view>
    </view>
  </block>
</view>
